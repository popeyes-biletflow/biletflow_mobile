# BiletFlow FastAPI origin (biletflow_web/backend), not the Supabase project URL. No /api suffix.
#   Physical phone (same Wi-Fi):  http://<computer LAN IPv4>:8000   e.g. http://192.168.0.157:8000
#   iOS simulator on the Mac:     http://127.0.0.1:8000
#   Android emulator:             http://10.0.2.2:8000
#   Docker demo (deploy/):        http://<computer LAN IPv4>:8000
# Plain HTTP is accepted only in development builds and only for private/loopback addresses.
EXPO_PUBLIC_API_URL=http://192.168.0.157:8000
# Optional: web app origin, enables "Forgot password?" (opens the web reset page).
EXPO_PUBLIC_WEB_URL=http://192.168.0.157:5173
