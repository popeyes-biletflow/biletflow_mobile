# BiletFlow FastAPI origin, not the Supabase project URL.
# Physical phone: replace with the computer's LAN IPv4 address (same Wi-Fi).
EXPO_PUBLIC_API_URL=http://192.168.0.157:8000
# web = existing biletflow_web API; mobile = extended contract after backend implementation.
EXPO_PUBLIC_API_MODE=web
# Local HTTP works only in development. Use HTTPS for production.
