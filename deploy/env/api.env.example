# FastAPI runtime configuration for the Docker demo. Copy to api.env (git-ignored) and fill in.
# Values are injected at container start; they are never copied into an image.

# Supabase project (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_or_publishable_key
# Server-side only; enables email outbox + recipient lookup (FS-20). Leave empty for in-app notices only.
SUPABASE_SERVICE_KEY=

# HMAC secret for ticket QR codes. Must be identical wherever tickets are issued and verified.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
QR_SECRET=replace_with_a_long_random_secret

# Origins as seen by browsers/phones. Use the computer's LAN IP so the Expo app and email links work.
PUBLIC_API_URL=http://192.168.0.157:8000
FRONTEND_URL=http://192.168.0.157:5173

EMAIL_ENABLED=true
EMAIL_FROM=BiletFlow <no-reply@biletflow.local>
EMAIL_LANG=ru
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false

PAID_SALES_ACTIVATION_FEE_KZT=5000
